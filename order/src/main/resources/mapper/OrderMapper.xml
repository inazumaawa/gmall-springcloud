<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="order.mapper.OrderMapper">
    <resultMap id="OrderResultMap" type="model.Order">
        <id property="id" column="id"/>
        <result property="createdTime" column="created_time"/>
        <result property="uid" column="uid"/>
        <result property="totalPrice" column="total_price"/>
        <result property="discountAmount" column="discount_amount"/>
        <result property="couponId" column="coupon_id"/>
        <result property="status" column="status"/>
        <result property="aid" column="aid"/>
        <result property="address" column="address"/>
        <collection property="orderItems" ofType="model.OrderItem"
                    column="id" select="findOrderItemByOid"/>
    </resultMap>

    <select id="findOrderByUid" resultMap="OrderResultMap" parameterType="int">
        SELECT o.id, o.uid, o.total_price, o.discount_amount, o.coupon_id,
               o.status, o.created_time, o.aid,
               CONCAT(a.province, a.city, a.district, a.detail,
                       ' (', a.receiver_name, ' ', a.phone, ')') AS address
        FROM orders o
        LEFT JOIN account.address a ON o.aid = a.id
        WHERE o.uid = #{uid}
    </select>

    <select id="findOrderItemByOid" resultType="model.OrderItem">
        SELECT * FROM order_item WHERE oid = #{oid}
    </select>
</mapper>
